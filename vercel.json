{
  "framework": "nextjs",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install",
  "crons": [
    {
      "path": "/api/isp/daily-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-orderry-statuses",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sync-orderry-orders",
      "schedule": "*/15 * * * *"
    }
  ]
}
